# All variables are optional and end up in the public bundle. Never put secrets here.

# Comma-separated RPC list (defaults: tenderly, mevblocker, drpc).
# VITE_RPC_URLS=https://mainnet.gateway.tenderly.co,https://rpc.mevblocker.io,https://eth.drpc.org

# Uniswap v4 OG/ETH pool id used for the ETH estimate.
# VITE_OG_ETH_POOL_ID=0x5f95e64cf8e8f4e4376c1d97b5959dc479abf7b191ba0b286faeb2ec4180a2f9

# Name shown in the owner disclosure of the built site. Leave unset to show
# "The contract owner is also the largest OG holder." Keep it out of git.
# VITE_OWNER_NAME=
